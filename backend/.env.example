PORT=4000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/synq
# Atlas: mongodb+srv://<username>:<password>@<cluster-host>/synq?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/synq
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173
# Only set to the exact number of trusted reverse proxies in your hosting topology.
TRUST_PROXY_HOPS=0
# Optional. AI requests return 503 until both are configured.
GROQ_API_KEY=
GROQ_MODEL=
