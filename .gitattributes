* text=auto
.gitattributes text eol=lf

# Keep project source consistent across Windows, macOS, Linux and CI.
*.css text eol=lf
*.env.example text eol=lf
*.html text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve binary assets exactly.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
